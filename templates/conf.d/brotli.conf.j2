# Requires nginx-module-brotli from blendbyte (load_module via modules-enabled).

brotli on;
brotli_comp_level 6;
brotli_static on;
brotli_types
    text/plain
    text/css
    text/xml
    text/javascript
    application/javascript
    application/json
    application/xml
    application/xml+rss
    application/xhtml+xml
    image/svg+xml
    font/woff2;
